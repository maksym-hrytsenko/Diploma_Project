<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Not used by the default ad-hoc build in packaging/build.sh — ad-hoc
         signing + hardened runtime is an unreliable combination for a
         PyInstaller bundle full of separately-vendored native libraries
         (torch/mlx/mediapipe .dylib files), since AMFI's library
         validation can reject them even though the app still runs fine
         signed ad-hoc WITHOUT the hardened runtime flag.

         This file exists for the Developer ID + notarization path only
         (see the commented-out steps at the end of build.sh): hardened
         runtime is mandatory for notarization, and these two entitlements
         are what keep a PyInstaller/ML app launchable under it. -->

    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <key>com.apple.security.device.camera</key>
    <true/>

    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
