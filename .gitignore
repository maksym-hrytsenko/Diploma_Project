venv/
__pycache__/
*.pyc
.DS_Store
logs/
.pytest_cache/
project/tests/benchmarks/resource_log_*.csv
project/tests/benchmarks/results/

# Decoded once by SyntheticMicrophoneInput (afconvert), regenerated on
# first use if missing — see project/tests/benchmarks/synthetic_microphone_input.py
project/tests/synthesized_voice/*.synthetic_*hz_mono16.wav

# record_gesture_sample.py's own temp file during the fps-correction
# re-encode, plus ad-hoc mislabeled-fps backups made while debugging it
project/tests/synthesized_gesture/*.raw_capture.mp4
project/tests/synthesized_gesture/*mislabeled*.mp4

# First-run onboarding marker (see src/utils/app_state.py) — per-install
# state, not project content
onboarding_shown

# PyInstaller build output — regenerated by packaging/build.sh
project/packaging/build/
project/packaging/dist/
project/packaging/output/

# Overleaf thesis export — Overleaf is the source of truth, not this repo's history
project/docs/thesis/
project/docs/*.zip

# Personal Ukrainian working copy used to review the thesis text against
# its Czech original — a working aid, not repository content
project/docs/thesis_ua_review.md
project/docs/thesis_ua_translation.md
