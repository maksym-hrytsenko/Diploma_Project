{
    "settings": {
        "signal_timeout": 2.0,
        "clear_signals_after_match": true
    },

    "modes": [

        {
            "mode": "presentation",

            "triggers": [
                { "source": "voice", "signal": "PRESENTATION_MODE" },
                { "source": "keyboard", "signal": "PRESENTATION_MODE_KEY" },
                { "source": "ui", "signal": "PRESENTATION_MODE" }
            ]
        },

        {
            "mode": "flip",

            "triggers": [
                { "source": "voice", "signal": "FLIP_MODE" },
                { "source": "keyboard", "signal": "FLIP_MODE_KEY" },
                { "source": "ui", "signal": "FLIP_MODE" }
            ]
        },

        {
            "mode": "cursor",

            "triggers": [
                { "source": "voice", "signal": "CURSOR_MODE" },
                { "source": "keyboard", "signal": "CURSOR_MODE_KEY" },
                { "source": "ui", "signal": "CURSOR_MODE" }
            ]
        },

        {
            "mode": "call",

            "triggers": [
                { "source": "voice", "signal": "CALL_MODE" },
                { "source": "keyboard", "signal": "CALL_MODE_KEY" },
                { "source": "ui", "signal": "CALL_MODE" }
            ]
        },

        {
            "mode": "quick_circle",

            "triggers": [
                { "source": "gesture", "signal": "HAND_SESSION_START" }
            ]
        }

    ],

    "environments": [

        {
            "environment": "work",
            "trigger": "WORK_MODE",

            "enter_actions": [
                "ENABLE_DO_NOT_DISTURB",
                "OPEN_SLACK",
                "OPEN_MAIL",
                "OPEN_CALENDAR"
            ],

            "exit_actions": [
                "DISABLE_DO_NOT_DISTURB"
            ]
        },

        {
            "environment": "job_search",
            "trigger": "JOB_SEARCH_MODE",

            "enter_actions": [
                "ENABLE_DO_NOT_DISTURB",
                "OPEN_JOB_SEARCH_WINDOWS"
            ],

            "exit_actions": [
                "DISABLE_DO_NOT_DISTURB"
            ]
        },

        {
            "environment": "study",
            "trigger": "STUDY_MODE",

            "enter_actions": [
                "ENABLE_DO_NOT_DISTURB",
                "OPEN_STUDY_WINDOWS"
            ],

            "exit_actions": [
                "DISABLE_DO_NOT_DISTURB"
            ]
        },

        {
            "environment": "movie",
            "trigger": "MOVIE_MODE",

            "enter_actions": [
                "ENABLE_DO_NOT_DISTURB",
                "PREVENT_DISPLAY_SLEEP",
                "OPEN_TV",
                "OPEN_NETFLIX",
                "RUN_CINEMA_MODE"
            ],

            "exit_actions": [
                "DISABLE_DO_NOT_DISTURB",
                "ALLOW_DISPLAY_SLEEP"
            ]
        },

        {
            "environment": "news",
            "trigger": "NEWS_MODE",

            "enter_actions": [
                "OPEN_NEWS_TABS"
            ],

            "exit_actions": []
        }

    ],

    "rules": [

        {
            "name": "open_browser",
            "conditions": { "voice": "OPEN_BROWSER" },
            "action": "OPEN_BROWSER"
        },

        {
            "name": "open_chatgpt",
            "conditions": { "voice": "OPEN_CHATGPT" },
            "action": "OPEN_CHATGPT"
        },

        {
            "name": "open_github",
            "conditions": { "voice": "OPEN_GITHUB" },
            "action": "OPEN_GITHUB"
        },

        {
            "name": "open_vscode",
            "conditions": { "voice": "OPEN_VSCODE" },
            "action": "OPEN_VSCODE"
        },

        {
            "name": "open_terminal",
            "conditions": { "voice": "OPEN_TERMINAL" },
            "action": "OPEN_TERMINAL"
        },

        {
            "name": "open_safari",
            "conditions": { "voice": "OPEN_SAFARI" },
            "action": "OPEN_SAFARI"
        },

        {
            "name": "open_chrome",
            "conditions": { "voice": "OPEN_CHROME" },
            "action": "OPEN_CHROME"
        },

        {
            "name": "open_spotify",
            "conditions": { "voice": "OPEN_SPOTIFY" },
            "action": "OPEN_SPOTIFY"
        },

        {
            "name": "open_slack",
            "conditions": { "voice": "OPEN_SLACK" },
            "action": "OPEN_SLACK"
        },

        {
            "name": "open_discord",
            "conditions": { "voice": "OPEN_DISCORD" },
            "action": "OPEN_DISCORD"
        },

        {
            "name": "open_mail",
            "conditions": { "voice": "OPEN_MAIL" },
            "action": "OPEN_MAIL"
        },

        {
            "name": "open_calendar",
            "conditions": { "voice": "OPEN_CALENDAR" },
            "action": "OPEN_CALENDAR"
        },

        {
            "name": "open_notes",
            "conditions": { "voice": "OPEN_NOTES" },
            "action": "OPEN_NOTES"
        },

        {
            "name": "open_telegram",
            "conditions": { "voice": "OPEN_TELEGRAM" },
            "action": "OPEN_TELEGRAM"
        },

        {
            "name": "open_finder",
            "conditions": { "voice": "OPEN_FINDER" },
            "action": "OPEN_FINDER"
        },

        {
            "name": "open_notion",
            "conditions": { "voice": "OPEN_NOTION" },
            "action": "OPEN_NOTION"
        },

        {
            "name": "open_photos",
            "conditions": { "voice": "OPEN_PHOTOS" },
            "action": "OPEN_PHOTOS"
        },

        {
            "name": "open_preview",
            "conditions": { "voice": "OPEN_PREVIEW" },
            "action": "OPEN_PREVIEW"
        },

        {
            "name": "open_settings",
            "conditions": { "voice": "OPEN_SETTINGS" },
            "action": "OPEN_SETTINGS"
        },

        {
            "name": "media_start",
            "conditions": { "voice": "START" },
            "action": "MEDIA_PLAY_PAUSE"
        },

        {
            "name": "media_stop",
            "conditions": { "voice": "STOP" },
            "action": "MEDIA_PLAY_PAUSE"
        },

        {
            "name": "media_pause_voice",
            "conditions": { "voice": "PAUSE" },
            "action": "MEDIA_PLAY_PAUSE"
        },

        {
            "name": "media_reset_voice",
            "conditions": { "voice": "RESET" },
            "action": "MEDIA_PLAY_PAUSE"
        },

        {
            "name": "media_next_track_voice",
            "conditions": { "voice": "NEXT_TRACK" },
            "action": "NEXT_TRACK"
        },

        {
            "name": "media_previous_track_voice",
            "conditions": { "voice": "PREVIOUS_TRACK" },
            "action": "PREVIOUS_TRACK"
        },

        {
            "name": "face_layer_next_track",
            "conditions": { "keyboard": "ALT_KEY", "face": "HEAD_TILT_RIGHT" },
            "action": "NEXT_TRACK"
        },

        {
            "name": "face_layer_previous_track",
            "conditions": { "keyboard": "ALT_KEY", "face": "HEAD_TILT_LEFT" },
            "action": "PREVIOUS_TRACK"
        },

        {
            "name": "face_layer_pause",
            "conditions": { "keyboard": "ALT_KEY", "face": "MOUTH_OPEN" },
            "action": "MEDIA_PLAY_PAUSE"
        },

        {
            "name": "face_layer_screenshot",
            "conditions": { "keyboard": "ALT_KEY", "face": "DOUBLE_BLINK" },
            "action": "TAKE_SCREENSHOT"
        },

        {
            "name": "face_layer_volume_up",
            "conditions": { "keyboard": "ALT_KEY", "face": "EYEBROWS_UP" },
            "action": "VOLUME_UP"
        },

        {
            "name": "face_layer_volume_down",
            "conditions": { "keyboard": "CTRL_KEY", "face": "EYEBROWS_UP" },
            "action": "VOLUME_DOWN"
        }

    ],

    "mode_rules": [

        {
            "name": "presentation_start_slideshow",
            "mode": "presentation",
            "conditions": { "voice": "START_SLIDESHOW" },
            "action": "START_SLIDESHOW"
        },

        {
            "name": "presentation_next_voice",
            "mode": "presentation",
            "conditions": { "voice": "NEXT_SLIDE" },
            "action": "NEXT_SLIDE"
        },

        {
            "name": "presentation_previous_voice",
            "mode": "presentation",
            "conditions": { "voice": "PREVIOUS_SLIDE" },
            "action": "PREVIOUS_SLIDE"
        },

        {
            "name": "presentation_next_key",
            "mode": "presentation",
            "conditions": { "keyboard": "KEY_RIGHT" },
            "action": "NEXT_SLIDE"
        },

        {
            "name": "presentation_previous_key",
            "mode": "presentation",
            "conditions": { "keyboard": "KEY_LEFT" },
            "action": "PREVIOUS_SLIDE"
        },

        {
            "name": "presentation_next_gesture",
            "mode": "presentation",
            "conditions": { "gesture": "HAND_RIGHT" },
            "action": "NEXT_SLIDE"
        },

        {
            "name": "presentation_previous_gesture",
            "mode": "presentation",
            "conditions": { "gesture": "HAND_LEFT" },
            "action": "PREVIOUS_SLIDE"
        },

        {
            "name": "flip_up",
            "mode": "flip",
            "conditions": { "gesture": "HAND_UP" },
            "action": "SCROLL_DOWN"
        },

        {
            "name": "flip_down",
            "mode": "flip",
            "conditions": { "gesture": "HAND_DOWN" },
            "action": "SCROLL_UP"
        },

        {
            "name": "flip_right",
            "mode": "flip",
            "conditions": { "gesture": "HAND_RIGHT" },
            "action": "FLIP_PREVIOUS"
        },

        {
            "name": "flip_left",
            "mode": "flip",
            "conditions": { "gesture": "HAND_LEFT" },
            "action": "FLIP_NEXT"
        },

        {
            "name": "cursor_click",
            "mode": "cursor",
            "conditions": { "gesture": "PINCH" },
            "action": "CLICK"
        },

        {
            "name": "cursor_right_click",
            "mode": "cursor",
            "conditions": { "gesture": "DOUBLE_PINCH" },
            "action": "RIGHT_CLICK"
        },

        {
            "name": "call_toggle_mic",
            "mode": "call",
            "conditions": { "gesture": "ONE_FINGER" },
            "action": "TOGGLE_MIC"
        },

        {
            "name": "call_toggle_camera",
            "mode": "call",
            "conditions": { "gesture": "TWO_FINGERS" },
            "action": "TOGGLE_CAMERA"
        },

        {
            "name": "call_toggle_call_audio",
            "mode": "call",
            "conditions": { "gesture": "THREE_FINGERS" },
            "action": "TOGGLE_CALL_AUDIO"
        },

        {
            "name": "call_toggle_background_blur",
            "mode": "call",
            "conditions": { "gesture": "FOUR_FINGERS" },
            "action": "TOGGLE_BACKGROUND_BLUR"
        },

        {
            "name": "quick_circle_select_presentation",
            "mode": "quick_circle",
            "conditions": { "gesture": "HAND_LEFT" },
            "enters_mode": "presentation"
        },

        {
            "name": "quick_circle_select_call",
            "mode": "quick_circle",
            "conditions": { "gesture": "HAND_RIGHT" },
            "enters_mode": "call"
        },

        {
            "name": "quick_circle_select_flip",
            "mode": "quick_circle",
            "conditions": { "gesture": "HAND_UP" },
            "enters_mode": "flip"
        },

        {
            "name": "quick_circle_select_cursor",
            "mode": "quick_circle",
            "conditions": { "gesture": "HAND_DOWN" },
            "enters_mode": "cursor"
        }

    ]
}
