{
    "settings": {
        "signal_timeout": 2.0,
        "clear_signals_after_match": true
    },

    "modes": [

        {
            "mode": "presentation",
            "trigger": "PRESENTATION_MODE"
        },

        {
            "mode": "study",
            "trigger": "STUDY_MODE"
        },

        {
            "mode": "coding",
            "trigger": "CODING_MODE"
        }

    ],

    "rules": [

        {
            "name": "open_chatgpt",

            "conditions": {
                "keyboard": "CTRL_ALT",
                "gesture": "Victory"
            },

            "action": "OPEN_CHATGPT"
        },

        {
            "name": "open_chatgpt_ok",

            "conditions": {
                "keyboard": "CTRL_ALT",
                "gesture": "OK"
            },

            "action": "OPEN_CHATGPT"
        },

        {
            "name": "open_browser",

            "conditions": {
                "keyboard": "CTRL_SHIFT",
                "voice": "OPEN_BROWSER"
            },

            "action": "OPEN_BROWSER"
        },

        {
            "name": "open_github",

            "conditions": {
                "keyboard": "ALT_SHIFT",
                "voice": "OPEN_GITHUB"
            },

            "action": "OPEN_GITHUB"
        },

        {
            "name": "take_screenshot_voice",

            "conditions": {
                "voice": "TAKE_SCREENSHOT",
                "gesture": "Closed_Fist"
            },

            "action": "TAKE_SCREENSHOT"
        },

        {
            "name": "take_screenshot_blink",

            "conditions": {
                "gesture": "DOUBLE_BLINK"
            },

            "action": "TAKE_SCREENSHOT"
        },

        {
            "name": "cursor_click",

            "conditions": {
                "gesture": "PINCH"
            },

            "action": "CLICK"
        },

        {
            "name": "window_snap_left",

            "conditions": {
                "keyboard": "ALT_SHIFT",
                "gesture": "HAND_LEFT"
            },

            "action": "MOVE_WINDOW_LEFT"
        },

        {
            "name": "window_snap_right",

            "conditions": {
                "keyboard": "ALT_SHIFT",
                "gesture": "HAND_RIGHT"
            },

            "action": "MOVE_WINDOW_RIGHT"
        },

        {
            "name": "window_maximize",

            "conditions": {
                "keyboard": "ALT_SHIFT", 
                "gesture": "HAND_UP"
            },

            "action": "MAXIMIZE_WINDOW"
        },

        {
            "name": "enter_study_mode",

            "conditions": {
                "voice": "STUDY_MODE"
            },

            "action": "ENTER_STUDY_MODE"
        },

        {
            "name": "enter_coding_mode",

            "conditions": {
                "voice": "CODING_MODE"
            },

            "action": "ENTER_CODING_MODE"
        }

    ],

    "mode_rules": [

        {
            "name": "presentation_next",
            "mode": "presentation",

            "conditions": {
                "gesture": "HAND_RIGHT"
            },

            "action": "NEXT_SLIDE"
        },

        {
            "name": "presentation_previous",
            "mode": "presentation",

            "conditions": {
                "gesture": "HAND_LEFT"
            },

            "action": "PREVIOUS_SLIDE"
        }

    ]
}
